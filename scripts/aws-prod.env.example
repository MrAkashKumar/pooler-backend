# Copy to aws-prod.env on the EC2 host and fill real values.
# Do not commit aws-prod.env. Prefer AWS Secrets Manager for production secrets.

HOST_PORT=8080
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
DB_DDL_AUTO=validate

# Amazon RDS for MySQL (production instance/database, never shared with staging).
DB_HOST=your-prod-rds-endpoint.ap-southeast-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=pooler
DB_USER=pooler_app
DB_PASS=change-me
DB_USE_SSL=true
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# Security
JWT_SECRET=replace-with-strong-base64-secret
APP_FRONTEND_BASE_URL=https://app.hoppo.app
CORS_ORIGINS=https://app.hoppo.app

# Amazon SES SMTP
MAIL_HOST=email-smtp.ap-southeast-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM=noreply@hoppo.app
MAIL_FROM_NAME=Hoppo

# Profile media S3 upload. Use an EC2 instance role, not static AWS keys.
PROFILE_MEDIA_S3_BUCKET=hoppo-profile-media-prod
PROFILE_MEDIA_S3_REGION=ap-southeast-1
PROFILE_MEDIA_KEY_PREFIX=hoppo/profile-media/prod
PROFILE_MEDIA_PUBLIC_BASE_URL=https://media.hoppo.app
PROFILE_MEDIA_MAX_SIZE_MB=5

# Runtime/logging
LOG_PATH=/var/log/hoppo/pooler-backend
APP_LOG_LEVEL=INFO
HIKARI_MAX_POOL_SIZE=20
HIKARI_MIN_IDLE=5

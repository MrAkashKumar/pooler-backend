{
  "info": {
    "_postman_id": "c2a4f6d8-cab5-4c2b-8e2a-pooler-full-001",
    "name": "Pooler Cab-Share API (Full)",
    "description": "Complete Postman collection for the **Pooler** Spring Boot backend.\n\n**Base URL:** `{{baseUrl}}` — defaults to `http://localhost:8888/pooler-backend` (`server.port=8888`, `server.servlet.contextPath=/pooler-backend`).\n\n**Auth flow:**\n1. `POST /api/v1/auth/register` — create account (auto-stores tokens via test script)\n2. `POST /api/v1/auth/login` — get access + refresh + session tokens (auto-stored)\n3. Bearer auth is configured at the collection level using `{{accessToken}}`\n4. `POST /api/v1/auth/refresh` — rotate access token before it expires\n5. `POST /api/v1/auth/logout` — revoke the current session\n\n**Mobile headers (sent automatically on auth requests):**\n- `X-Device-Id`, `X-Platform`, `X-App-Version`, `X-FCM-Token`\n- `X-Session-Token` — required by `@ValidSession` endpoints (toggle discovery, send/accept/confirm invitation, ride status/cancel, revoke session)\n\n**13 folders, 53 requests** matching the Swagger tags.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{accessToken}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Default any missing collection variables on the very first run.",
          "if (!pm.collectionVariables.get('baseUrl'))    pm.collectionVariables.set('baseUrl',    'http://localhost:8888/pooler-backend');",
          "if (!pm.collectionVariables.get('deviceId'))   pm.collectionVariables.set('deviceId',   'postman-device-001');",
          "if (!pm.collectionVariables.get('platform'))   pm.collectionVariables.set('platform',   'ANDROID');",
          "if (!pm.collectionVariables.get('appVersion')) pm.collectionVariables.set('appVersion', '1.0.0');",
          "if (!pm.collectionVariables.get('fcmToken'))   pm.collectionVariables.set('fcmToken',   'fcm-test-token-xyz');"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl",      "value": "http://localhost:8888/pooler-backend", "type": "string" },
    { "key": "accessToken",  "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "sessionToken", "value": "", "type": "string" },
    { "key": "userId",       "value": "", "type": "string" },
    { "key": "deviceId",     "value": "postman-device-001", "type": "string" },
    { "key": "platform",     "value": "ANDROID", "type": "string" },
    { "key": "appVersion",   "value": "1.0.0",   "type": "string" },
    { "key": "fcmToken",     "value": "fcm-test-token-xyz", "type": "string" },
    { "key": "contactEntityId",    "value": "", "type": "string" },
    { "key": "locationEntityId",   "value": "", "type": "string" },
    { "key": "invitationEntityId", "value": "", "type": "string" },
    { "key": "rideEntityId",       "value": "", "type": "string" },
    { "key": "sessionId",          "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 · Public",
      "description": "Health and version probes — no authentication required.",
      "item": [
        {
          "name": "GET Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/health",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","public","health"]
            },
            "description": "Returns service status, version, java runtime, timestamp. Used by mobile apps on cold-start to detect outages."
          }
        },
        {
          "name": "GET Version",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/version",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","public","version"]
            },
            "description": "Backend version + minimum required mobile app versions for forced-upgrade prompts."
          }
        }
      ]
    },
    {
      "name": "02 · Authentication",
      "description": "Register, login, refresh, logout, password reset.",
      "item": [
        {
          "name": "POST Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('accessToken',  json.data.accessToken  || '');",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken || '');",
                  "  pm.collectionVariables.set('sessionToken', json.data.sessionToken || '');",
                  "  if (json.data.user && json.data.user.entityId) {",
                  "    pm.collectionVariables.set('userId', json.data.user.entityId);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id",  "value": "{{deviceId}}" },
              { "key": "X-Platform",   "value": "{{platform}}" },
              { "key": "X-App-Version","value": "{{appVersion}}" },
              { "key": "X-FCM-Token",  "value": "{{fcmToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"deviceId\": \"{{deviceId}}\",\n  \"platform\": \"{{platform}}\",\n  \"appVersion\": \"{{appVersion}}\",\n  \"fcmToken\": \"{{fcmToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","auth","register"]
            },
            "description": "**Rate limit:** 5 req / 5 min per IP.\n\nValidation: `firstName` 2–100, `lastName` 2–100, valid `email`, `password` 8–72 with upper/lower/digit/special.\n\nResponse contains `accessToken`, `refreshToken`, `sessionToken`, `user`. Tokens are auto-saved to collection variables."
          }
        },
        {
          "name": "POST Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('accessToken',  json.data.accessToken  || '');",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken || '');",
                  "  pm.collectionVariables.set('sessionToken', json.data.sessionToken || '');",
                  "  if (json.data.user && json.data.user.entityId) {",
                  "    pm.collectionVariables.set('userId', json.data.user.entityId);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id",  "value": "{{deviceId}}" },
              { "key": "X-Platform",   "value": "{{platform}}" },
              { "key": "X-App-Version","value": "{{appVersion}}" },
              { "key": "X-FCM-Token",  "value": "{{fcmToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"deviceId\": \"{{deviceId}}\",\n  \"platform\": \"{{platform}}\",\n  \"appVersion\": \"{{appVersion}}\",\n  \"fcmToken\": \"{{fcmToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","auth","login"]
            },
            "description": "**Rate limit:** 10 req / 60s per IP. Returns access (15m), refresh (7d) and session (30m) tokens."
          }
        },
        {
          "name": "POST Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken',  json.data.accessToken);",
                  "  if (json.data.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","auth","refresh"]
            },
            "description": "Exchange a valid refresh token for a fresh access + refresh pair."
          }
        },
        {
          "name": "POST Logout (current device)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","auth","logout"]
            },
            "description": "Revokes the access + refresh + session tokens for the current device."
          }
        },
        {
          "name": "POST Logout All Devices",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","auth","logout-all"]
            },
            "description": "Revokes every active session for the authenticated user."
          }
        },
        {
          "name": "POST Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","auth","forgot-password"]
            },
            "description": "**Rate limit:** 3 req / 10 min per IP. Always returns 200 to avoid email-enumeration."
          }
        },
        {
          "name": "POST Reset Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"<token-from-email>\",\n  \"newPassword\": \"<new-password>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","auth","reset-password"]
            },
            "description": "Completes the reset flow using the token mailed to the user."
          }
        }
      ]
    },

            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/version",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "version"]
            },
            "description": "Returns backend version + minimum required mobile app versions."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",

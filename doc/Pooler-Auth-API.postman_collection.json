            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "public", "health"]
            },
            "description": "Returns service status, version, java runtime, timestamp."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": { "raw": "{{baseUrl}}/api/v1/public/health" }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"status\": \"UP\",\n    \"service\": \"Pooler Service\",\n    \"version\": \"1.0.0\",\n    \"java\": \"21\",\n    \"timestamp\": \"2026-05-05T10:00:00Z\"\n  },\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            }
          ]
        },

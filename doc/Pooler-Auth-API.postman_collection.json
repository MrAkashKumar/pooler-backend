                "url": { "raw": "{{baseUrl}}/api/v1/public/version" }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"backendVersion\": \"1.0.0\",\n    \"minAndroidVersion\": \"1.0.0\",\n    \"minIosVersion\": \"1.0.0\"\n  },\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "Register, login, token refresh, password reset, logout.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('accessToken',  json.data.accessToken  || '');",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken || '');",
                  "  pm.collectionVariables.set('sessionToken', json.data.sessionToken || '');",
                  "  if (json.data.user && json.data.user.entityId) {",
                  "    pm.collectionVariables.set('userId', json.data.user.entityId);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" },
              { "key": "X-Platform", "value": "{{platform}}" },
              { "key": "X-App-Version", "value": "{{appVersion}}" },
              { "key": "X-FCM-Token", "value": "{{fcmToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"deviceId\": \"{{deviceId}}\",\n  \"platform\": \"{{platform}}\",\n  \"appVersion\": \"{{appVersion}}\",\n  \"fcmToken\": \"{{fcmToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "**Rate limit:** 5 req / 5 min per IP.\n\n**Validation:**\n- `firstName` 2–100 chars (required)\n- `lastName` 2–100 chars (required)\n- `email` valid email (required)\n- `password` 8–72 chars; must contain uppercase, lowercase, digit, special char (required)\n- `deviceId`, `platform`, `appVersion`, `fcmToken` optional\n\nResponse contains `accessToken`, `refreshToken`, `sessionToken`, `user`. The collection's test script automatically stores them as collection variables."
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/v1/auth/register" }
              },
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Resource created successfully\",\n  \"data\": {\n    \"accessToken\": \"<jwt-token>\",\n    \"refreshToken\": \"<jwt-token>\",\n    \"sessionToken\": \"<jwt-token>\",\n    \"tokenType\": \"Bearer\",\n    \"accessTokenExpiresIn\": 900,\n    \"refreshTokenExpiresIn\": 604800,\n    \"user\": {\n      \"entityId\": \"USR0000001\",\n      \"email\": \"{{authEmail}}\",\n      \"firstName\": \"John\",\n      \"lastName\": \"Doe\",\n      \"fullName\": \"John Doe\",\n      \"role\": \"USER\",\n      \"status\": \"ACTIVE\",\n      \"createdAt\": \"2026-05-05T10:00:00Z\"\n    }\n  },\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            },
            {
              "name": "400 Validation Error",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/v1/auth/register" }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Password must contain uppercase, lowercase, digit and special character\",\n  \"errorCode\": \"VALIDATION_FAILED\",\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            },
            {
              "name": "409 User Already Exists",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/v1/auth/register" }
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"User already exists with email: {{authEmail}}\",\n  \"errorCode\": \"USER_ALREADY_EXISTS\",\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('accessToken',  json.data.accessToken  || '');",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken || '');",
                  "  pm.collectionVariables.set('sessionToken', json.data.sessionToken || '');",
                  "  if (json.data.user && json.data.user.entityId) {",
                  "    pm.collectionVariables.set('userId', json.data.user.entityId);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Device-Id", "value": "{{deviceId}}" },
              { "key": "X-Platform", "value": "{{platform}}" },
              { "key": "X-App-Version", "value": "{{appVersion}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\",\n  \"deviceId\": \"{{deviceId}}\",\n  \"platform\": \"{{platform}}\",\n  \"appVersion\": \"{{appVersion}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "**Rate limit:** 10 req / 60 s per IP.\n\nReturns:\n- `accessToken` (15 m)\n- `refreshToken` (7 d)\n- `sessionToken` (30 m)"
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/v1/auth/login" }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"accessToken\": \"<jwt-token>\",\n    \"refreshToken\": \"<jwt-token>\",\n    \"sessionToken\": \"<jwt-token>\",\n    \"tokenType\": \"Bearer\",\n    \"accessTokenExpiresIn\": 900,\n    \"refreshTokenExpiresIn\": 604800,\n    \"user\": {\n      \"entityId\": \"USR0000001\",\n      \"email\": \"{{authEmail}}\",\n      \"firstName\": \"John\",\n      \"lastName\": \"Doe\",\n      \"fullName\": \"John Doe\",\n      \"role\": \"USER\",\n      \"status\": \"ACTIVE\"\n    }\n  },\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            },
            {
              "name": "401 Invalid Credentials",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/v1/auth/login" }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid email or password\",\n  \"errorCode\": \"INVALID_CREDENTIALS\",\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            },
            {
              "name": "423 Account Locked",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/v1/auth/login" }
              },
              "status": "Locked",
              "code": 423,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Account locked due to too many failed attempts. Try again in 30 minutes.\",\n  \"errorCode\": \"ACCOUNT_LOCKED\",\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.data) {",
                  "  pm.collectionVariables.set('accessToken',  json.data.accessToken  || '');",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken || '');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Exchange a valid refresh token for a new access + refresh pair (rotation)."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh" }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"data\": {\n    \"accessToken\": \"<jwt-token>\",\n    \"refreshToken\": \"<jwt-token>\",\n    \"tokenType\": \"Bearer\",\n    \"accessTokenExpiresIn\": 900\n  },\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            },
            {
              "name": "401 Refresh Token Expired",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh" }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": false,\n  \"message\": \"Refresh token has expired. Please log in again.\",\n  \"errorCode\": \"REFRESH_TOKEN_EXPIRED\",\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Logout (current device)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Accept", "value": "application/json" },
              { "key": "X-Session-Token", "value": "{{sessionToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revokes the current access + refresh + session tokens."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/auth/logout" } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Logged out successfully\",\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Logout (all devices)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout-all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout-all"]
            },
            "description": "Revokes ALL tokens for the authenticated user across every device."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/auth/logout-all" } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Logged out from all devices\",\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            }
          ]
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "**Rate limit:** 3 req / 10 min per IP.\n\nAlways returns 200 OK regardless of whether the email exists (prevents user enumeration). If the email is registered, a reset link is emailed."
          },
          "response": [
            {
              "name": "200 OK",
              "originalRequest": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/auth/forgot-password" } },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"If this email is registered, a reset link has been sent.\",\n  \"timestamp\": \"2026-05-05T10:00:00Z\"\n}"
            }
          ]
        },
        {

<configuration debug="false" scan="true" scanPeriod="30 seconds">

    <!-- Writable by default for local development and tests; override in production. -->
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}"/>

    <timestamp key="bySecond" datePattern="yyyy-MM-dd:HH-mm-ss.SSS"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/pooler-backend.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/archive/pooler-backend.%d{yyyy-MM-dd_HH}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>%date %X{x_request_id} %-5level [%thread] [%file:%line] %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="async-FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="FILE" />
    </appender>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%date %X{x_request_id} %highlight(%-5level) [%thread] [%file:%line] %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.akash.pooler_backend" level="${APP_LOG_LEVEL:-INFO}" />

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="async-FILE" />
    </root>

</configuration>
